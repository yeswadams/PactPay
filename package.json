{
  "name": "pactpay",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/nx/bin/nx.js dev web",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "affected": "nx affected -t lint test build",
    "format": "prettier --write .",
    "db:migrate": "node --env-file-if-exists=.env.local packages/database/src/migrate.ts",
    "web3:generate": "nx run blockchain:generate",
    "web3:deploy": "nx run blockchain:generate && node --env-file-if-exists=.env.local packages/blockchain/scripts/deploy-local.ts",
    "web3:sync": "node --env-file-if-exists=.env.local packages/blockchain/scripts/sync.ts",
    "web3:demo": "node --env-file-if-exists=.env.local packages/blockchain/scripts/demo.ts",
    "demo:local": "node scripts/demo-local.mjs",
    "check": "nx run-many -t lint typecheck test build",
    "admin:grant": "node --env-file-if-exists=.env.local apps/web/scripts/grant-operator.ts",
    "demo:operator": "node --env-file=.env.demo.local apps/web/scripts/enable-local-operator.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "nx": "^24.0.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
